server {
    listen __PORT__ default_server;
    listen [::]:__PORT__ default_server;
    server_name _;

    root /var/www/frontend;
    index index.html;

    client_max_body_size 20M;

    # Compresión Gzip para carga rápida (RNF-01)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # 1. Rutas del API Laravel (/api/v1/...) y healthcheck (/up)
    location ^~ /api {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /up {
        try_files $uri /index.php?$query_string;
    }

    # Procesamiento PHP-FPM local dentro del mismo contenedor
    location = /index.php {
        root /var/www/html/public;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        include fastcgi_params;
        fastcgi_read_timeout 120;
    }

    # 2. Archivos estáticos del Frontend (HTML, CSS, JS, PWA, Avatares)
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
